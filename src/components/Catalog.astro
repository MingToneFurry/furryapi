---
// 接口目录：首页和文档首页共用。每行一个接口，整行可点。
import { href, pick, t, type Lang } from '../i18n';
import { catalog, docPath, groupByCategory, shortPath } from '../apis';
import { CATEGORIES } from '../apis/types';

interface Props {
  lang: Lang;
  /** home：首页精简版；index：文档首页，按分类分组 */
  variant?: 'home' | 'index';
}

const { lang, variant = 'home' } = Astro.props;
const groups = groupByCategory(catalog);
---

{
  variant === 'home' ? (
    <section class="catalog" aria-labelledby="catalog-title">
      <div class="section-head">
        <h2 id="catalog-title">{t(lang, 'catalog.title')}</h2>
        <p>
          <a href={href(lang, '/apiIntro/')}>{t(lang, 'catalog.all')}</a>
        </p>
      </div>
      <ul role="list" class="rows">
        {catalog.map((e) => (
          <li class="row">
            <p class="cat">{pick(CATEGORIES[e.category].name, lang)}</p>
            <h3 class="name">
              <a href={href(lang, docPath(e))}>{pick(e.name, lang)}</a>
            </h3>
            <p class="summary">{pick(e.summary, lang)}</p>
            <p class="path">{shortPath(e) ? <code>{shortPath(e)}</code> : t(lang, 'docs.tool')}</p>
          </li>
        ))}
      </ul>
    </section>
  ) : (
    <div class="catalog">
      {groups.map((g) => (
        <section class="group" aria-labelledby={`cat-${g.category}`}>
          <h2 id={`cat-${g.category}`} class="group-title">
            {pick(g.name, lang)}
          </h2>
          <ul role="list" class="rows">
            {g.items.map((e) => (
              <li class="row">
                <h3 class="name">
                  <a href={href(lang, docPath(e))}>{pick(e.name, lang)}</a>
                </h3>
                <p class="summary">{pick(e.summary, lang)}</p>
                <p class="path">{shortPath(e) ? <code>{shortPath(e)}</code> : t(lang, 'docs.tool')}</p>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  )
}

<style>
  .catalog {
    container-type: inline-size;
  }

  .rows {
    border-top: 1px solid var(--rule);
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: 6rem minmax(9rem, 14rem) minmax(0, 1fr) minmax(7rem, auto);
    align-items: baseline;
    gap: var(--space-2) var(--space-5);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--rule);
  }
  .group .row {
    grid-template-columns: minmax(9rem, 16rem) minmax(0, 1fr) minmax(7rem, auto);
  }

  .cat,
  .path {
    color: var(--ash);
    font-size: var(--step--1);
  }
  .path {
    text-align: right;
  }
  .path code {
    padding: 0;
    background: none;
    color: var(--ink);
  }

  .name {
    font-size: var(--step-2);
    line-height: 1.3;
  }
  .name a {
    text-decoration-color: transparent;
  }
  .name a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .row:hover .name a {
    text-decoration-color: currentColor;
  }
  .name a:focus-visible {
    outline: none;
  }
  .row:has(.name a:focus-visible) {
    outline: 2px solid var(--mint);
    outline-offset: 2px;
  }

  .summary {
    max-width: 34em;
  }

  .group + .group {
    margin-top: var(--space-8);
  }
  .group-title {
    margin-bottom: var(--space-4);
    font-size: var(--step--1);
    font-family: var(--font-sans);
    font-weight: 500;
    color: var(--ash);
  }

  @container (max-width: 46rem) {
    .row,
    .group .row {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'cat path'
        'name name'
        'summary summary';
      padding-block: var(--space-4);
    }
    .group .row {
      grid-template-areas:
        'name path'
        'summary summary';
    }
    .cat {
      grid-area: cat;
    }
    .path {
      grid-area: path;
    }
    .name {
      grid-area: name;
    }
    .summary {
      grid-area: summary;
      color: var(--ash);
    }
  }
</style>
