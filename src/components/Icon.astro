---
// 全站用到的几个线条图标，统一 24 网格、1.6 线宽；paw 是站标的爪印，实心
interface Props {
  name: 'paw' | 'copy' | 'check' | 'refresh' | 'external' | 'close' | 'prev' | 'next' | 'arrow' | 'send';
  class?: string;
}

const { name, class: className = 'icon' } = Astro.props;

const strokes: Record<Exclude<Props['name'], 'paw'>, string> = {
  copy: '<rect x="8.5" y="8.5" width="11" height="11" rx="2.5"/><path d="M15.5 8.5V6.8a2.3 2.3 0 0 0-2.3-2.3H6.8a2.3 2.3 0 0 0-2.3 2.3v6.4a2.3 2.3 0 0 0 2.3 2.3h1.7"/>',
  check: '<path d="M5 12.5l4.2 4.2L19 7"/>',
  refresh: '<path d="M19.5 12a7.5 7.5 0 1 1-2.2-5.3"/><path d="M19.6 4.4v4.3h-4.3"/>',
  external: '<path d="M8.5 6.5h9v9"/><path d="M17.5 6.5l-11 11"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  prev: '<path d="M14.5 6l-6 6 6 6"/>',
  next: '<path d="M9.5 6l6 6-6 6"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  send: '<path d="M5 12h13M12.5 6.5L18 12l-5.5 5.5"/>',
};
---

{
  name === 'paw' ? (
    <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <ellipse cx="5.3" cy="10.6" rx="1.9" ry="2.4" transform="rotate(-24 5.3 10.6)" />
      <ellipse cx="9.3" cy="6.7" rx="2" ry="2.6" transform="rotate(-8 9.3 6.7)" />
      <ellipse cx="14.7" cy="6.7" rx="2" ry="2.6" transform="rotate(8 14.7 6.7)" />
      <ellipse cx="18.7" cy="10.6" rx="1.9" ry="2.4" transform="rotate(24 18.7 10.6)" />
      <path d="M12 12.4c-3.1 0-6 2.8-6 5.4 0 1.7 1.3 2.6 2.8 2.6 1.2 0 2.1-.6 3.2-.6s2 .6 3.2.6c1.5 0 2.8-.9 2.8-2.6 0-2.6-2.9-5.4-6-5.4z" />
    </svg>
  ) : (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={strokes[name]}
    />
  )
}
