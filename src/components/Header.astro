---
import { href, t, type Lang } from '../i18n';
import { STATUS_URL } from '../lib/site';

interface Props {
  lang: Lang;
  /** 与语言无关的当前路径，例如 /apiIntro/ip-api/ */
  path: string;
}

const { lang, path } = Astro.props;
const other: Lang = lang === 'zh' ? 'en' : 'zh';
const isDocs = path.startsWith('/apiIntro/');
const isThanks = path.startsWith('/thank/');
---

<header class="site-header wrap">
  <a class="wordmark serif" href={href(lang, '/')} aria-label="FurryAPI">FurryAPI</a>

  <nav class="site-nav" aria-label={t(lang, 'nav.label')}>
    <a href={href(lang, '/apiIntro/')} aria-current={isDocs ? 'page' : undefined}>{t(lang, 'nav.docs')}</a>
    <a href={href(lang, '/thank/')} aria-current={isThanks ? 'page' : undefined}>{t(lang, 'nav.thanks')}</a>
    <a href={STATUS_URL} target="_blank" rel="noopener noreferrer">{t(lang, 'nav.status')}</a>
  </nav>

  <div class="site-tools">
    <a
      class="lang-switch"
      href={href(other, path)}
      hreflang={other === 'zh' ? 'zh-CN' : 'en'}
      lang={other === 'zh' ? 'zh-CN' : 'en'}
      data-set-lang={other}>{t(lang, 'lang.switch')}</a
    >
    <button class="theme-toggle" type="button" data-theme-toggle aria-label={t(lang, 'theme.toggle')} title={t(lang, 'theme.toggle')}>
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
        <circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="M10 2.75a7.25 7.25 0 0 1 0 14.5z" fill="currentColor"></path>
      </svg>
    </button>
  </div>
</header>

<style>
  .site-header {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-5);
  }

  .wordmark {
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1;
    text-decoration: none;
  }

  .site-nav {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-6);
    font-size: 0.9375rem;
  }

  .site-nav a,
  .lang-switch {
    text-decoration-line: underline;
    text-decoration-color: transparent;
  }
  .site-nav a:hover,
  .lang-switch:hover,
  .site-nav a[aria-current='page'] {
    text-decoration-color: currentColor;
  }

  .site-tools {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-left: var(--space-6);
    border-left: 1px solid var(--rule);
    font-size: 0.9375rem;
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-right: -0.4rem;
    padding: 0;
    border: 0;
    background: none;
  }
  .theme-toggle svg {
    transition: transform 400ms var(--ease);
  }
  :global(:root[data-theme='dark']) .theme-toggle svg {
    transform: rotate(180deg);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle svg {
      transform: rotate(180deg);
    }
  }

  @media (max-width: 47.99rem) {
    .site-header {
      grid-template-columns: 1fr auto;
      padding-block: var(--space-4) var(--space-3);
    }
    .site-nav {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-content: flex-start;
      gap: var(--space-5);
      padding-top: var(--space-3);
      border-top: 1px solid var(--rule);
    }
    .site-tools {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
