---
import Icon from './Icon.astro';
import { href, t, type Lang } from '../i18n';
import { STATUS_URL } from '../lib/site';

interface Props {
  lang: Lang;
  /** 与语言无关的当前路径，用来生成另一种语言的地址和标出当前栏目 */
  path: string;
  /** 首页的页头叠在首屏照片上，滚动后才出现底色 */
  overlay?: boolean;
}

const { lang, path, overlay = false } = Astro.props;
const other: Lang = lang === 'zh' ? 'en' : 'zh';
const inDocs = path.startsWith('/apiIntro/');
---

<header class="site-header" data-header data-overlay={overlay ? '' : undefined} data-top={overlay ? '' : undefined}>
  <div class="bar wrap-wide">
    <a class="brand" href={href(lang, '/')}>
      <Icon name="paw" class="paw" />
      <span>FurryAPI</span>
    </a>

    <nav aria-label={t(lang, 'nav.label')}>
      <ul role="list">
        <li><a href={href(lang, '/apiIntro/')} aria-current={inDocs ? 'page' : undefined}>{t(lang, 'nav.apis')}</a></li>
        <li class="wide"><a href={href(lang, '/#gallery')}>{t(lang, 'nav.gallery')}</a></li>
        <li class="wide">
          <a href={href(lang, '/thank/')} aria-current={path === '/thank/' ? 'page' : undefined}>{t(lang, 'nav.sources')}</a>
        </li>
        <li class="wide">
          <a href={STATUS_URL} target="_blank" rel="noopener noreferrer">
            {t(lang, 'nav.status')}<Icon name="external" class="ext" />
          </a>
        </li>
      </ul>
      <a class="lang" href={href(other, path)} hreflang={other === 'zh' ? 'zh-CN' : 'en'} lang={other === 'zh' ? 'zh-CN' : 'en'} data-set-lang={other}>
        {t(lang, 'lang.switch')}
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: rgb(5 5 5 / 0.78);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1px solid var(--line);
    transition:
      background 0.35s,
      border-color 0.35s;
  }
  /* 首页：叠在照片上，顶部完全透明，滚动后由脚本去掉 data-top */
  .site-header[data-overlay] {
    position: fixed;
    inset: 0 0 auto;
  }
  .site-header[data-overlay][data-top] {
    background: transparent;
    border-color: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 100%;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--bone);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .brand :global(.paw) {
    width: 20px;
    height: 20px;
    color: var(--champagne);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  ul {
    display: flex;
    gap: 28px;
  }
  nav a {
    color: var(--text-2);
    font-size: 14.5px;
    text-decoration: none;
    transition: color 0.2s;
  }
  nav a:hover,
  nav a[aria-current] {
    color: var(--bone);
  }
  nav a[aria-current] {
    text-decoration: underline;
    text-decoration-color: var(--champagne);
    text-underline-offset: 8px;
  }
  nav :global(.ext) {
    display: inline;
    width: 12px;
    height: 12px;
    margin-left: 3px;
    vertical-align: -1px;
    opacity: 0.7;
  }

  .lang {
    padding: 6px 12px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    font-size: 13px;
  }
  .lang:hover {
    border-color: var(--line-3);
  }

  @media (max-width: 760px) {
    .wide {
      display: none;
    }
    nav,
    ul {
      gap: 18px;
    }
  }
</style>
