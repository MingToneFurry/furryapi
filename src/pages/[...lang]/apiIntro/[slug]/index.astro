---
// 单个接口的文档页：左侧接口导航，中间说明，右侧在线试用（窄屏时排在说明和正文之间）
import Base from '../../../../layouts/Base.astro';
import CopyButton from '../../../../components/CopyButton.astro';
import DocNav from '../../../../components/docs/DocNav.astro';
import DocSections from '../../../../components/docs/DocSections.astro';
import Examples from '../../../../components/docs/Examples.astro';
import Playground from '../../../../components/docs/Playground.astro';
import { apis, docPath } from '../../../../apis';
import { CATEGORIES, type ApiDoc } from '../../../../apis/types';
import { LANGS, pick, t, type Lang } from '../../../../i18n';
import { inline, plain } from '../../../../lib/format';

export function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    apis.map((doc) => ({ params: { lang: lang === 'zh' ? undefined : lang, slug: doc.slug }, props: { lang, doc } })),
  );
}

const { lang, doc } = Astro.props as { lang: Lang; doc: ApiDoc };

const sections = [
  { id: 'endpoint', label: t(lang, 'docs.endpoint') },
  { id: 'params', label: t(lang, 'docs.params') },
  ...(doc.fields ? [{ id: 'fields', label: t(lang, 'docs.fields') }] : []),
  ...(doc.tables ?? []).map((tb, i) => ({ id: `table-${i + 1}`, label: pick(tb.title, lang) })),
  ...(doc.errors ? [{ id: 'errors', label: t(lang, 'docs.errors') }] : []),
  ...(doc.notes ? [{ id: 'notes', label: t(lang, 'docs.notes') }] : []),
  { id: 'examples', label: t(lang, 'docs.examples') },
];
---

<Base lang={lang} title={`${pick(doc.name, lang)} - FurryAPI`} description={plain(pick(doc.summary, lang))} path={docPath(doc)}>
  <div class="docs wrap-wide">
    <aside class="side">
      <div class="sticky">
        <DocNav lang={lang} current={doc.slug} sections={sections} />
      </div>
    </aside>

    <header class="intro">
      <p class="eyebrow">{pick(CATEGORIES[doc.category].name, lang)} · API</p>
      <h1>{pick(doc.name, lang)}</h1>
      <p class="lede" set:html={inline(pick(doc.intro, lang))} />

      <section id="endpoint" class="endpoint" aria-labelledby="endpoint-title">
        <h2 id="endpoint-title" class="eyebrow">{t(lang, 'docs.endpoint')}</h2>
        <ul role="list">
          {
            doc.endpoints.map((ep) => (
              <li>
                <div class="ep">
                  <span class="method">{ep.method}</span>
                  <code>{ep.url}</code>
                  <CopyButton lang={lang} text={ep.url} />
                </div>
                {ep.note && <p class="ep-note" set:html={inline(pick(ep.note, lang))} />}
              </li>
            ))
          }
        </ul>
        {
          doc.methods && (
            <p class="methods">
              {t(lang, 'docs.methods')}：<span set:html={inline(pick(doc.methods, lang))} />
            </p>
          )
        }
      </section>
    </header>

    <aside class="try" aria-label={t(lang, 'docs.playground')}>
      <div class="sticky">
        <Playground lang={lang} doc={doc} />
      </div>
    </aside>

    <article class="body">
      <DocSections lang={lang} doc={doc} />
      <Examples lang={lang} examples={doc.examples} />
    </article>
  </div>
</Base>

<script>
  // 试用面板比可视区域高时，让它先随页面滚动、底部露出来后再停住，而不是在面板里面出现滚动条
  const panel = document.querySelector<HTMLElement>('.try .sticky');
  if (panel) {
    const update = () => {
      const style = getComputedStyle(panel);
      const top = parseFloat(style.getPropertyValue('--header-h')) + parseFloat(style.getPropertyValue('--docs-top'));
      const fit = window.innerHeight - panel.offsetHeight - 24;
      panel.style.setProperty('--try-top', `${Math.min(top, fit)}px`);
    };
    new ResizeObserver(update).observe(panel);
    window.addEventListener('resize', update);
    update();
  }
</script>

<style>
  /* 侧栏吸顶的位置和页面上边距一致：一开始就停在吸顶的位置，滚动时完全不动 */
  .docs {
    --docs-top: 40px;
    display: grid;
    grid-template-columns: 196px minmax(0, 1fr) 384px;
    grid-template-areas:
      'side intro try'
      'side body try';
    grid-template-rows: auto 1fr;
    gap: 0 64px;
    align-items: start;
    padding-block: var(--docs-top) 140px;
  }
  .side {
    grid-area: side;
    align-self: stretch;
  }
  .intro {
    grid-area: intro;
  }
  .try {
    grid-area: try;
    align-self: stretch;
  }
  .body {
    grid-area: body;
    max-width: 760px;
  }
  .sticky {
    position: sticky;
    top: calc(var(--header-h) + var(--docs-top));
  }
  /* 试用面板比窗口高时（例如出了预览图），先跟着页面滚，底部露出来再停住；top 由下面的脚本按面板高度算 */
  .try .sticky {
    top: var(--try-top, calc(var(--header-h) + var(--docs-top)));
  }
  .side .sticky {
    padding-left: 14px;
  }

  .intro {
    max-width: 760px;
  }
  .intro h1 {
    margin-top: 14px;
    font-size: clamp(36px, 4vw, 54px);
  }
  .intro .lede {
    margin-top: 20px;
  }

  .endpoint {
    margin-top: 40px;
    scroll-margin-top: calc(var(--header-h) + 32px);
  }
  .endpoint h2 {
    margin-bottom: 12px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    color: var(--text-3);
  }
  .endpoint li + li {
    margin-top: 10px;
  }
  .ep {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 8px 10px 16px;
    border: 1px solid var(--line-2);
    border-radius: 12px;
    background: var(--surface);
    font-size: 14px;
  }
  .ep code {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
    color: var(--bone);
  }
  .method {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--champagne);
  }
  .ep-note {
    margin-top: 8px;
    font-size: 14px;
    color: var(--text-3);
  }
  .methods {
    margin-top: 14px;
    font-size: 14px;
    color: var(--text-3);
  }
  .methods :global(code) {
    color: var(--text-2);
  }

  /* 中等宽度：左侧导航改成顶部一行，正文和试用面板两栏 */
  @media (max-width: 1280px) {
    .docs {
      grid-template-columns: minmax(0, 1fr) 340px;
      grid-template-areas:
        'side side'
        'intro try'
        'body try';
      grid-template-rows: auto auto 1fr;
      gap: 0 48px;
    }
    .side {
      margin-bottom: 32px;
    }
    .side .sticky {
      position: static;
      padding-left: 0;
    }
  }
  @media (max-width: 1100px) {
    .docs {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'side' 'intro' 'try' 'body';
      grid-template-rows: none;
      gap: 40px;
      padding-top: 32px;
    }
    .side {
      margin-bottom: 0;
    }
    .sticky {
      position: static;
    }
  }
</style>
