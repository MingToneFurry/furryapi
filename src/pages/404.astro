---
// 404：找不到页面时 Cloudflare Pages 返回这一页（状态码 404）。中英文写在同一页里，不进搜索引擎。
// 背景是一张压得很暗的照片：宽屏用光翼的那张，竖屏用黑暗里一点光的那张。
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { GALLERY, HERO_LANDSCAPE } from '../lib/photos';
import { t } from '../i18n';

const land = HERO_LANDSCAPE.find((p) => p.n === 171) ?? HERO_LANDSCAPE[0];
const port = GALLERY.find((p) => p.n === 2396) ?? GALLERY[0];
const L = await getImage({ src: land.src, widths: [960, 1440, 1920], format: 'webp', quality: 70 });
const P = await getImage({ src: port.src, widths: [480, 720, 960], format: 'webp', quality: 70 });
---

<Base lang="zh" title="404 - FurryAPI" path="/" noindex overlay>
  <section class="nf" aria-labelledby="nf-title">
    <picture class="bg">
      <source media="(max-aspect-ratio: 4/5)" srcset={P.srcSet.attribute} sizes="100vw" />
      <img src={L.src} srcset={L.srcSet.attribute} sizes="100vw" alt="" decoding="async" />
    </picture>
    <div class="shade"></div>

    <div class="copy wrap">
      <p class="nf-code">404</p>
      <h1 id="nf-title">{t('zh', 'nf.title')}</h1>
      <p class="title-en" lang="en" data-display>{t('en', 'nf.title')}</p>
      <p class="lede">
        <span>{t('zh', 'nf.lead')}</span>
        <span lang="en">{t('en', 'nf.lead')}</span>
      </p>
      <div class="actions">
        <a class="btn btn-solid" href="/">{t('zh', 'nf.home')}</a>
        <a class="btn" href="/apiIntro/">{t('zh', 'nf.docs')}</a>
        <a class="more" href="/en/" lang="en">{t('en', 'nf.home')}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
  }
  .bg,
  .shade {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  /* 压暗写在 picture 上：显影动画结束时会把 img 自己的 filter 清掉 */
  .bg {
    filter: brightness(0.55) saturate(0.85);
  }
  .bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    animation: develop 2s var(--ease-out) both;
  }
  .shade {
    background:
      radial-gradient(90% 80% at 50% 45%, rgb(5 5 5 / 0.2) 0%, rgb(5 5 5 / 0.85) 75%, var(--stage) 100%),
      linear-gradient(to right, rgb(5 5 5 / 0.75), rgb(5 5 5 / 0) 60%);
  }
  /* 竖屏时文字正好压在人物身上，再暗一些 */
  @media (max-aspect-ratio: 4/5) {
    .bg {
      filter: brightness(0.45) saturate(0.85);
    }
    .shade {
      background: linear-gradient(to bottom, rgb(5 5 5 / 0.2), rgb(5 5 5 / 0.6) 35%, rgb(5 5 5 / 0.7) 70%, var(--stage));
    }
  }

  .copy {
    padding-block: calc(var(--header-h) + 48px) 64px;
  }
  .copy > * {
    animation: rise 1s var(--ease-out) both;
  }
  .nf-code {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.2em;
    color: var(--champagne);
  }
  h1 {
    margin-top: 20px;
    font-size: clamp(40px, 5.6vw, 80px);
  }
  .title-en {
    margin-top: 8px;
    font-size: clamp(24px, 3vw, 40px);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: #85827b;
  }
  .lede {
    max-width: 34em;
    margin-top: 28px;
  }
  .lede span {
    display: block;
  }
  .lede span[lang='en'] {
    color: var(--text-3);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    margin-top: 36px;
  }
</style>
