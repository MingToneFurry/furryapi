---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { href, htmlLang, t, type Lang } from '../i18n';
import { ALLOWED_HOSTS, FAVICON, MXANA_ID, UMAMI_ID } from '../lib/site';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** 与语言无关的路径，例如 /apiIntro/ */
  path: string;
  /** 为 true 时不放进搜索引擎（例如 404） */
  noindex?: boolean;
}

const { lang, title, description = t(lang, 'site.description'), path, noindex = false } = Astro.props;
const site = Astro.site!;
const canonical = new URL(href(lang, path), site).href;
const zhUrl = new URL(href('zh', path), site).href;
const enUrl = new URL(href('en', path), site).href;
const prod = import.meta.env.PROD;
---

<!doctype html>
<html lang={htmlLang(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline src="/scripts/domain-redirect.js" data-target-host="api.furry.ist" data-allowed-hosts={ALLOWED_HOSTS}></script>
    <script is:inline>
      // 尽早应用主题，避免闪烁；记住用户选过英文时，中文页跳到对应的英文页
      (function () {
        try {
          var theme = localStorage.getItem('theme');
          if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
          var p = location.pathname;
          if (localStorage.getItem('language') === 'en' && p !== '/en' && p.indexOf('/en/') !== 0 && document.documentElement.lang === 'zh-CN') {
            location.replace('/en' + p + location.search + location.hash);
          }
        } catch (e) {}
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={zhUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FurryAPI" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000000" />

    <link rel="icon" type="image/png" sizes="40x40" href={FAVICON(1)} />
    <link rel="icon" type="image/png" sizes="100x100" href={FAVICON(3)} />
    <link rel="icon" type="image/png" sizes="140x140" href={FAVICON(4)} />
    <link rel="icon" type="image/png" sizes="640x640" href={FAVICON(5)} />
    <link rel="apple-touch-icon" sizes="140x140" href={FAVICON(4)} />

    <link rel="preload" href="/fonts/serif-sc.woff2?v=__FONT_VERSION__" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/serif-latin.woff2?v=__FONT_VERSION__" as="font" type="font/woff2" crossorigin />
    <slot name="head" />

    {prod && <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={UMAMI_ID}></script>}
    {
      prod && (
        <script is:inline define:vars={{ mxanaId: MXANA_ID }}>
          (function (p) {
            var s = document.createElement('script');
            s.async = true;
            s.charset = 'UTF-8';
            s.id = 'MXA_COLLECT';
            s.src = (location.protocol === 'https:' ? 'https://' : 'http://') + 'mxana.tacool.com/sdk.js';
            p.d = s;
            s.onload = function () {
              if (window.MXA && window.MXA.init) window.MXA.init(p);
            };
            document.head.appendChild(s);
          })({ id: mxanaId, useHeatMap: true, useErrorLog: true });
        </script>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'skip')}</a>
    <Header lang={lang} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      import { initChrome } from '../scripts/chrome';
      initChrome();
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--gutter);
    top: -4rem;
    z-index: 10;
    padding: var(--space-2) var(--space-4);
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
  }
  .skip-link:focus {
    top: var(--space-2);
  }
</style>
