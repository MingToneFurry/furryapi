---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import { href, htmlLang, t, type Lang } from '../i18n';
import { fontFaceCss, fontUrl } from '../lib/fonts';
import { ALLOWED_HOSTS, FAVICON, MXANA_ID, UMAMI_ID } from '../lib/site';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** 与语言无关的路径，例如 /apiIntro/ */
  path: string;
  /** 为 true 时不放进搜索引擎（例如 404） */
  noindex?: boolean;
  /** 首页：页头叠在首屏照片上 */
  overlay?: boolean;
  /** 结构化数据（JSON-LD），由 src/lib/schema.ts 生成 */
  schema?: object;
}

const { lang, title, description = t(lang, 'site.description'), path, noindex = false, overlay = false, schema } = Astro.props;
const site = Astro.site!;
const canonical = new URL(href(lang, path), site).href;
const zhUrl = new URL(href('zh', path), site).href;
const enUrl = new URL(href('en', path), site).href;
const prod = import.meta.env.PROD;
// JSON 里的 < 写成转义，内容里就算出现 </script> 也不会提前结束标签
const jsonLd = schema && JSON.stringify(schema).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={htmlLang(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline src="/scripts/domain-redirect.js" data-target-host="api.furry.ist" data-allowed-hosts={ALLOWED_HOSTS}></script>
    <script is:inline>
      // 记住用户选过英文时，中文页跳到对应的英文页
      (function () {
        try {
          var p = location.pathname;
          if (localStorage.getItem('language') === 'en' && p !== '/en' && p.indexOf('/en/') !== 0 && document.documentElement.lang === 'zh-CN') {
            location.replace('/en' + p + location.search + location.hash);
          }
        } catch (e) {}
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      /* 404 这类不收录的页面会出现在任意地址上，不写规范地址和语言对应 */
      !noindex && (
        <>
          <link rel="canonical" href={canonical} />
          <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
          <link rel="alternate" hreflang="en" href={enUrl} />
          <link rel="alternate" hreflang="x-default" href={zhUrl} />
        </>
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FurryAPI" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'zh' ? 'en_US' : 'zh_CN'} />
    <!-- 分享图用网站图标（640×640 的方图），所以 Twitter 用小图卡片 -->
    <meta property="og:image" content={FAVICON(5)} />
    <meta property="og:image:width" content="640" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content={t(lang, 'og.alt')} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#050505" />

    <link rel="icon" type="image/jpeg" sizes="40x40" href={FAVICON(1)} />
    <link rel="icon" type="image/jpeg" sizes="100x100" href={FAVICON(3)} />
    <link rel="icon" type="image/jpeg" sizes="140x140" href={FAVICON(4)} />
    <link rel="icon" type="image/jpeg" sizes="640x640" href={FAVICON(5)} />
    <link rel="apple-touch-icon" sizes="140x140" href={FAVICON(4)} />
    {jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}

    <!-- 自托管字体：地址在构建结束时换成带内容哈希的文件名 -->
    <style is:inline set:html={fontFaceCss()}></style>
    {lang === 'zh' && <link rel="preload" href={fontUrl('sans-sc')} as="font" type="font/woff2" crossorigin />}
    <link rel="preload" href={fontUrl('mono')} as="font" type="font/woff2" crossorigin />
    <slot name="head" />

    {prod && <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={UMAMI_ID}></script>}
    {
      prod && (
        <script is:inline define:vars={{ mxanaId: MXANA_ID }}>
          (function (p) {
            var s = document.createElement('script');
            s.async = true;
            s.charset = 'UTF-8';
            s.id = 'MXA_COLLECT';
            s.src = (location.protocol === 'https:' ? 'https://' : 'http://') + 'mxana.tacool.com/sdk.js';
            p.d = s;
            s.onload = function () {
              if (window.MXA && window.MXA.init) window.MXA.init(p);
            };
            document.head.appendChild(s);
          })({ id: mxanaId, useHeatMap: true, useErrorLog: true });
        </script>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'skip')}</a>
    <Header lang={lang} path={path} overlay={overlay} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <Lightbox lang={lang} />

    <script>
      import { initChrome } from '../scripts/chrome';
      initChrome();
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    left: 16px;
    top: -64px;
    z-index: 100;
    padding: 10px 16px;
    border-radius: 8px;
    background: var(--bone);
    color: #0b0b0b;
    text-decoration: none;
  }
  .skip-link:focus {
    top: 12px;
  }
</style>
